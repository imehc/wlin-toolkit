{
  "name": "wlin-toolkit",
  "version": "0.3.0",
  "description": "A JavaScript toolkit for WebAssembly integration with Rust",
  "main": "pkg/wlin_toolkit.js",
  "type": "module",
  "scripts": {
    "build:npm": "rimraf pkg && wasm-pack build && npm run pre",
    "build:ui": "wasm-pack build --target bundler && astro build",
    "build": "npm run build:npm",
    "dev": "wasm-pack build && astro dev",
    "preview": "astro preview",
    "test": "cargo test && wasm-pack test --headless",
    "pre": "sh prepublish.sh"
  },
  "devDependencies": {
    "@astrojs/node": "^11.1.14",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "astro": "^7.4.13",
    "daisyui": "^5.8.2",
    "rimraf": "^6.1.4",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite-plugin-wasm": "^3.6.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@astrojs/svelte": "^9.1.6",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svelte": "^5.59.1"
  }
}
